{
  "expo": {
    "name": "MOSHCHAT",
    "slug": "moshchat",
    "scheme": "moshchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EFE9DE",
    "ios": {
      "bundleIdentifier": "at.moshchat.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "MOSHCHAT nutzt die Kamera, um den Check-in-Code am Einlass zu scannen.",
        "NSPhotoLibraryUsageDescription": "MOSHCHAT braucht Zugriff auf deine Fotos für dein Profilbild und Eventbilder."
      }
    },
    "android": {
      "package": "at.moshchat.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EFE9DE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      "expo-video",
      "expo-sharing",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Anton-Regular.ttf",
            "./assets/fonts/Archivo-Regular.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf",
            "./assets/fonts/IBMPlexMono-Regular.ttf",
            "./assets/fonts/IBMPlexMono-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#EFE9DE",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MOSHCHAT nutzt die Kamera, um den Check-in-Code am Einlass zu scannen.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MOSHCHAT braucht Zugriff auf deine Fotos für dein Profilbild und Eventbilder.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3ED08B",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "f714ff2c-1eea-48a7-bade-c928ab8014d3"
      }
    },
    "owner": "vienduo"
  }
}
